# Engine and database settings, read by spectra-api, spectra-db and docker compose.
# Copy to .env (git-ignored) and fill in. Real secrets never go in this file.

# ── Postgres ──
# docker compose creates this database; outside compose, point it at your own Postgres 16+.
POSTGRES_USER=spectra
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=spectra
DATABASE_URL=postgres://spectra:change-me-local-only@127.0.0.1:5432/spectra

# ── spectra-api ──
# Keep the engine private: 127.0.0.1 locally (compose binds 0.0.0.0 inside its private network).
SPECTRA_API_ADDR=127.0.0.1:8000
SPECTRA_CORS_ORIGINS=http://localhost:3000
SPECTRA_DB_MAX_CONNECTIONS=10
# Apply pending migrations when the API starts (handy in development; run `spectra-db migrate` in production).
SPECTRA_MIGRATE_ON_START=true
# Shared with the frontend (web/frontend/.env.local). 32+ characters: `openssl rand -base64 48`.
ENGINE_SECRET=

# ── spectra-db seed ──
# `spectra-db seed` creates this admin (no password: use "Forgot password") and a "dev" workspace.
ADMIN_EMAIL=
