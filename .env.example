# Engine and database settings, read by spectra-api, spectra-db and docker compose.
# Copy to .env (git-ignored) and fill in. Real secrets never go in this file.

# ── Postgres ──
# docker compose creates this database; outside compose, point it at your own Postgres 16+.
POSTGRES_USER=spectra
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=spectra
DATABASE_URL=postgres://spectra:change-me-local-only@127.0.0.1:5432/spectra

# ── spectra-api ──
# Keep the engine private: 127.0.0.1 locally (compose binds 0.0.0.0 inside its private network).
SPECTRA_API_ADDR=127.0.0.1:8000
SPECTRA_CORS_ORIGINS=http://localhost:3000
SPECTRA_DB_MAX_CONNECTIONS=10
# Apply pending migrations when the API starts (handy in development; run `spectra-db migrate` in production).
SPECTRA_MIGRATE_ON_START=true
# Shared with the frontend (web/frontend/.env.local). 32+ characters: `openssl rand -base64 48`.
ENGINE_SECRET=
# Optional Sentry or GlitchTip DSN for API and worker error/panic reports.
SENTRY_DSN=
# Monitoring-profile Grafana password. Replace before exposing or deploying Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only-grafana-password

# ── spectra-db seed ──
# `spectra-db seed` creates this admin (no password: use "Forgot password") and a "dev" workspace.
ADMIN_EMAIL=

# ── spectra-worker ──
SPECTRA_WORKER_CONCURRENCY=2
SPECTRA_WORKSPACE_MAX_RUNNING=2
# Comma-separated subset of benchmark,risk,stress to split workers by job kind (default: all).
# SPECTRA_WORKER_KINDS=benchmark
SPECTRA_ARTIFACT_QUOTA_BYTES=1073741824
# Artifact storage: local (ARTIFACT_DIR) or s3 (needs a worker built with --features s3).
ARTIFACT_STORAGE=local
ARTIFACT_DIR=artifacts
# ARTIFACT_S3_BUCKET=spectra-artifacts
# ARTIFACT_S3_PREFIX=dev
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_REGION=us-east-1
# MinIO: AWS_ENDPOINT=http://127.0.0.1:9000 and AWS_ALLOW_HTTP=true
# /health and Prometheus /metrics for the worker (unset: none).
# SPECTRA_WORKER_METRICS_ADDR=127.0.0.1:9100

# ── Logging (spectra-api and spectra-worker log JSON lines) ──
RUST_LOG=info
