#!/usr/bin/env bash
# Fast check before every commit: formatting only (seconds). The full CI checks run on push.
# Skip once with `git commit --no-verify` (CI will still check).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '\.rs$|(^|/)Cargo\.toml$|^rustfmt\.toml$|^rust-toolchain\.toml$'; then
  if ! cargo fmt --all --check >/dev/null 2>&1; then
    echo "pre-commit: Rust formatting differs. Run 'cargo fmt --all', then 'git add' and commit again." >&2
    cargo fmt --all --check 2>&1 | head -40 >&2 || true
    exit 1
  fi
fi
