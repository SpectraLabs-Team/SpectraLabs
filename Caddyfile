# Public edge for the Spectra dashboard (M20 step 12).
#
# Only the Next.js frontend is published. The engine API, its /metrics and the
# workers stay on the private compose network; Caddy never routes to them.
#
#   docker compose --profile proxy up -d
#
# SITE_ADDRESS is ":80" (plain HTTP, local) by default. Set it to a domain, e.g.
# SITE_ADDRESS=app.spectralabs.example, and Caddy obtains and renews a TLS
# certificate automatically (ports 80 and 443 must reach this host).
# Outside compose: UPSTREAM=127.0.0.1:3000 caddy run --config Caddyfile

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The frontend sets its own Content-Security-Policy; these complement it.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	reverse_proxy {$UPSTREAM:frontend:3000}
}
