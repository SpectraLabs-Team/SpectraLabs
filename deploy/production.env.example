# Production settings for docker compose (M20 step 12).
#   cp deploy/production.env.example .env      then fill in every CHANGE-ME
#   docker compose --profile proxy --profile monitoring up -d --build
# Never commit the filled-in copy: .env is git-ignored. Generate secrets with
#   openssl rand -base64 48
# and use different secrets for staging and production.

# ── Postgres ──
POSTGRES_USER=spectra
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=spectra_production

# ── Engine ──
ENGINE_SECRET=CHANGE-ME
SENTRY_DSN=
SPECTRA_CORS_ORIGINS=https://app.spectralabs.example
RUST_LOG=warn

# ── Workers ──  (scale: docker compose up -d --scale worker=N)
SPECTRA_WORKER_CONCURRENCY=4
SPECTRA_WORKSPACE_MAX_RUNNING=4

# ── Public edge (Caddy obtains the TLS certificate for this name) ──
SITE_ADDRESS=app.spectralabs.example

# ── Metrics ──
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME

# ── Artifacts in S3 (optional; add -f deploy/compose.s3.yml) ──
# ARTIFACT_S3_BUCKET=spectra-artifacts-production
# ARTIFACT_S3_PREFIX=
# AWS_ACCESS_KEY_ID=CHANGE-ME
# AWS_SECRET_ACCESS_KEY=CHANGE-ME
# AWS_REGION=eu-west-1
# AWS_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# AWS_ALLOW_HTTP=false

# ── Dashboard ──
# The frontend container reads web/frontend/.env.local (see web/frontend/.env.example):
# AUTH_SECRET, SECRETS_MASTER_KEY, ADMIN_EMAIL and the mail settings go there, with
# DATABASE_URL pointing at postgres://...@postgres:5432/<POSTGRES_DB>.
