{
  "id": null,
  "uid": "spectralabs-overview",
  "title": "Spectra Labs overview",
  "tags": ["spectralabs", "m20"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(api_responses_total[5m]))", "legendFormat": "requests/s", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "API p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 seconds", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Job queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (status) (jobs_queue_depth)", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Database pool connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance) (db_pool_connections)", "legendFormat": "{{instance}} current", "refId": "A" }, { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance) (db_pool_idle)", "legendFormat": "{{instance}} idle", "refId": "B" }]
    },
    {
      "id": 5,
      "title": "Job duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(job_duration_seconds_bucket[5m])))", "legendFormat": "{{kind}} p95 seconds", "refId": "A" }]
    }
  ]
}
