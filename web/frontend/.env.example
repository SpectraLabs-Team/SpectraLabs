# Copy to .env.local with `npm run setup` (it also generates AUTH_SECRET). Never commit .env.local.

# Where the Next.js server reaches the Rust engine. Server-side only: the browser always
# goes through the signed-in proxy at /api/engine, so the engine can stay bound to 127.0.0.1.
ENGINE_URL=http://127.0.0.1:8000
# Signs the X-Spectra-Identity header (user, active workspace, role) that the proxy sends with
# every signed-in engine call. Start the engine with the same value so it verifies callers:
#   ENGINE_SHARED_SECRET=<same value> cargo run --release -p spectra-api
# `npm run setup` generates one. Format: lib/server/engineIdentity.ts and crates/spectra-api/src/identity.rs.
ENGINE_SHARED_SECRET=

# ── Database (server-side; required) ──
# Postgres connection. `npm run dev` creates the database and tables if they don't exist.
#   Postgres.app or Homebrew (your macOS user, no password):  postgresql://localhost:5432/spectralabs
#   Docker (`docker compose up -d db` from the repo root):     postgresql://spectra:spectra@localhost:5432/spectralabs
DATABASE_URL=
# Tests create and drop their own schema in this database (defaults to DATABASE_URL).
# TEST_DATABASE_URL=

# ── Broker key storage (server-side) ──
# Master key for stored broker API keys: base64 of 32 random bytes (`npm run setup` makes one).
# It wraps each workspace's data key; the database never holds it. Back it up separately from
# database backups: if it is lost, every stored broker key is unrecoverable (users re-enter them).
# Rotation: "2:<new>,1:<old>" (first = current), `npm run secrets:rotate`, then drop the old entry.
SECRETS_MASTER_KEY=

# ── Auth (server-side; required — the app refuses to start without AUTH_SECRET) ──
# Keys the hashes of session tokens stored in the database. At least 32 random characters;
# `npm run setup` writes 48 random bytes. Each environment (laptop, staging, production) needs its
# own. Changing it signs everyone out.
AUTH_SECRET=
# Seeds the first platform admin: this email becomes admin at sign-up while no admin exists yet.
# After that, roles live in the database: `npm run admin -- grant|revoke|list`.
ADMIN_EMAIL=
# Gmail account + App Password (Google Account → Security → App passwords) used to send
# verification codes. Use a dedicated account; revoke the App Password if it ever leaks.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Public address of the app (optional): security emails link to <APP_URL>/account.
# APP_URL=https://app.example.com

# Set to 1 to disable HaveIBeenPwned breached-password check (e.g. for offline dev/testing)
# HIBP_DISABLED=1

# ── Browser security (M19 task 14) ──
# Content-Security-Policy: report-only (default; violations go to /api/csp-report and the server
# log, nothing is blocked), enforce, or off. Run report-only first, check the log, then enforce.
# CSP_MODE=report-only
# Extra origins allowed to send POST/PUT/PATCH/DELETE to the API, when the app is served from more
# than one domain (APP_URL is always allowed). Comma-separated full origins.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Strict-Transport-Security turns on automatically when APP_URL is https://. HSTS=on|off overrides;
# HSTS_INCLUDE_SUBDOMAINS=1 extends it to every subdomain (only when all of them serve HTTPS).
