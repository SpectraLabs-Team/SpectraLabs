# Where the Next.js server reaches the Rust engine. Server-side only: the browser always
# goes through the signed-in proxy at /api/engine, so the engine can stay bound to 127.0.0.1.
ENGINE_URL=http://127.0.0.1:8000

# ── Auth (server-side; required in production) ──
# Random 32+ byte string, e.g. `openssl rand -base64 48`. Signs session cookies.
AUTH_SECRET=
# The one email that gets the admin role on sign-up.
ADMIN_EMAIL=
# Gmail account + App Password used to send verification codes.
GMAIL_USER=
GMAIL_APP_PASSWORD=
