# Copy to .env.local with `npm run setup` (it also generates AUTH_SECRET). Never commit .env.local.

# Where the Next.js server reaches the Rust engine. Server-side only: the browser always
# goes through the signed-in proxy at /api/engine, so the engine can stay bound to 127.0.0.1.
ENGINE_URL=http://127.0.0.1:8000

# ── Auth (server-side; required — the app refuses to start without AUTH_SECRET) ──
# Signs session cookies. At least 32 random characters; `npm run setup` writes 48 random bytes.
# Each environment (your laptop, staging, production) needs its own. Changing it signs everyone out.
AUTH_SECRET=
# The one email that gets the admin role on sign-up.
ADMIN_EMAIL=
# Gmail account + App Password (Google Account → Security → App passwords) used to send
# verification codes. Use a dedicated account; revoke the App Password if it ever leaks.
GMAIL_USER=
GMAIL_APP_PASSWORD=
