{
  "openapi": "3.1.0",
  "info": {
    "title": "Spectra Labs engine API",
    "description": "Reached only through the dashboard's server. Every /api route needs the HMAC headers X-Spectra-User, X-Spectra-Workspace, X-Request-Id, X-Spectra-Timestamp and X-Spectra-Signature (see crates/spectra-api/src/auth.rs). Timestamps are UTC RFC 3339; ids are UUIDv7; lists page with an opaque cursor.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/benchmark": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "Benchmark the engine on a portfolio.",
        "operationId": "benchmark_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Benchmark report"
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "list_experiments",
        "responses": {
          "200": {
            "description": "Workspace experiments"
          }
        }
      },
      "post": {
        "tags": [
          "registry"
        ],
        "operationId": "create_experiment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExperiment"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments/{id}": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "get_experiment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experiment"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments/{id}/lineage": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "get_lineage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Root-to-leaf experiment lineage"
          }
        }
      }
    },
    "/api/v1/experiments/{id}/runs": {
      "post": {
        "tags": [
          "registry"
        ],
        "operationId": "create_backtest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBacktest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Backtest queued"
          },
          "422": {
            "description": "Invalid dataset or request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "The workspace's jobs, newest first.",
        "operationId": "list_jobs",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "queued, running, succeeded, failed or cancelled",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "next_cursor from the previous page",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1..200, default 50",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPage"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Queue a job.",
        "operationId": "create_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJob"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "400": {
            "description": "The account has no workspace (code `no_workspace`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          },
          "422": {
            "description": "Unknown kind or an invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "One job.",
        "operationId": "get_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel a job: queued jobs stop at once, running jobs at the worker's next\ncheck (within a few seconds). Finished jobs are returned unchanged.",
        "operationId": "cancel_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "Which risk metric names are computable (not the Prometheus metrics).",
        "operationId": "metrics_handler",
        "responses": {
          "200": {
            "description": "Metric names"
          }
        }
      }
    },
    "/api/v1/registry/export": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "export_jsonl",
        "responses": {
          "200": {
            "description": "Registry JSONL export"
          }
        }
      }
    },
    "/api/v1/registry/import": {
      "post": {
        "tags": [
          "registry"
        ],
        "operationId": "import_jsonl",
        "responses": {
          "200": {
            "description": "Imported event count"
          },
          "409": {
            "description": "Workspace is not empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          },
          "422": {
            "description": "Invalid or corrupt JSONL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/registry/verify": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "verify",
        "responses": {
          "200": {
            "description": "Registry chain verification"
          }
        }
      }
    },
    "/api/v1/risk": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "A risk metric for a portfolio.",
        "operationId": "risk_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RiskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Risk report"
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "list_runs",
        "parameters": [
          {
            "name": "experiment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "strategy",
            "in": "path",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "min_sharpe",
            "in": "path",
            "required": true,
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          {
            "name": "only_trials",
            "in": "path",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "status",
            "in": "path",
            "description": "`queued`, `running`, `succeeded`, `failed` or `cancelled`.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "path",
            "description": "`next_cursor` from the previous page.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "limit",
            "in": "path",
            "description": "Page size, 1 through 200 (default 50).",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace runs"
          }
        }
      },
      "post": {
        "tags": [
          "registry"
        ],
        "operationId": "create_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBacktest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Backtest queued; without experiment_id it is recorded under \"Unsorted\""
          },
          "422": {
            "description": "Invalid dataset or request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{id}": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "get_run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{id}/artifacts/{kind}": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "get_run_artifact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The artifact's bytes"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{id}/notes": {
      "post": {
        "tags": [
          "registry"
        ],
        "operationId": "add_run_note",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNote"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Note recorded"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sample-portfolio": {
      "get": {
        "tags": [
          "engine"
        ],
        "summary": "A sample portfolio CSV.",
        "operationId": "sample_portfolio",
        "responses": {
          "200": {
            "description": "`{csv}`"
          }
        }
      }
    },
    "/api/v1/stress": {
      "post": {
        "tags": [
          "engine"
        ],
        "summary": "Run a stress scenario on a portfolio.",
        "operationId": "stress_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StressRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stress report"
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDoc"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "probes"
        ],
        "summary": "Liveness.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The process is up"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "probes"
        ],
        "summary": "Readiness: 200 when both the database and at least one worker answer,\notherwise 503. Compose starts the API and worker together after migrations.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "The database and a worker are available"
          },
          "503": {
            "description": "The database or worker is unavailable or not configured"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BenchmarkRequest": {
        "type": "object",
        "description": "`POST /api/v1/benchmark` body (also the `benchmark` job payload).",
        "required": [
          "portfolio_csv"
        ],
        "properties": {
          "portfolio_csv": {
            "type": "string",
            "description": "Portfolio CSV."
          },
          "repetitions": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "1..30, default 5.",
            "minimum": 0
          },
          "simulations": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Paths per run, default 100,000.",
            "minimum": 0
          },
          "warmups": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "0..5, default 1.",
            "minimum": 0
          }
        }
      },
      "CreateBacktest": {
        "type": "object",
        "required": [
          "csv"
        ],
        "properties": {
          "csv": {
            "type": "string",
            "description": "OHLCV CSV with timestamp, symbol, open, high, low, close and volume columns."
          },
          "experiment_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "`POST /api/v1/runs` only: the experiment to record the run under.\nOmitted: the workspace's default \"Unsorted\" experiment."
          },
          "fast": {
            "type": "integer",
            "format": "int32",
            "description": "Short SMA period; 1 through 999 and less than `slow`.",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "description": "Optional note recorded with the run."
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "Job priority, -10 through 10."
          },
          "slow": {
            "type": "integer",
            "format": "int32",
            "description": "Long SMA period; 2 through 1,000 and greater than `fast`.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "CreateExperiment": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "hypothesis": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "CreateJob": {
        "type": "object",
        "description": "`POST /api/v1/jobs` body.",
        "required": [
          "kind",
          "payload"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "One of `benchmark`, `risk`, `stress`."
          },
          "payload": {
            "type": "object",
            "description": "The same body the matching synchronous route takes."
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "description": "-10..10; higher runs first. Default 0."
          }
        },
        "additionalProperties": false
      },
      "CreateNote": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "The note, 1 through 2,000 characters."
          }
        },
        "additionalProperties": false
      },
      "ErrorDoc": {
        "type": "object",
        "description": "Every error response.",
        "required": [
          "code",
          "message",
          "request_id",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable: `invalid_request`, `unauthenticated`, `not_found`, `no_workspace`, ..."
          },
          "detail": {
            "type": "string",
            "description": "Deprecated copy of `message`, removed with the `/api/...` aliases."
          },
          "details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Extra structured information, or null."
          },
          "message": {
            "type": "string",
            "description": "For people."
          },
          "request_id": {
            "type": "string",
            "description": "Matches the `X-Request-Id` response header."
          }
        }
      },
      "JobPage": {
        "type": "object",
        "description": "A page of jobs.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobView"
            },
            "description": "Newest first."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Pass as `cursor` for the next page; null on the last."
          }
        }
      },
      "JobView": {
        "type": "object",
        "description": "A job as the API shows it (the payload is not echoed: it can be megabytes).",
        "required": [
          "id",
          "kind",
          "status",
          "priority",
          "attempts",
          "max_attempts",
          "progress",
          "cancel_requested",
          "created_at",
          "run_after"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "format": "int32",
            "description": "Attempts started."
          },
          "cancel_requested": {
            "type": "boolean",
            "description": "A cancel was asked for while it ran."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Queued at (UTC, RFC 3339)."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The latest error."
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
